<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Sattleme_Payment::css/payment-page.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="sattleme.payment.page"
                   template="Sattleme_Payment::payment/page.phtml" cacheable="false">
                <arguments>
                    <argument name="view_model" xsi:type="object">Sattleme\Payment\ViewModel\PaymentPage</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
