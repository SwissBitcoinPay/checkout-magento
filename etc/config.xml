<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <sattleme>
                <model>SattlemePaymentFacade</model>
                <active>0</active>
                <!-- The key, decrypted when read (MetadataConfigTypeProcessor), encrypted in the database. -->
                <integration_key backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <minutes>15</minutes>
                <title/>
                <description/>
                <!-- Any action: can_initialize makes Payment::place() run the "initialize" command. -->
                <payment_action>authorize</payment_action>
                <can_initialize>1</can_initialize>
                <can_use_checkout>1</can_use_checkout>
                <can_use_internal>0</can_use_internal>
                <can_authorize>0</can_authorize>
                <can_capture>0</can_capture>
                <can_capture_partial>0</can_capture_partial>
                <can_refund>0</can_refund>
                <can_void>0</can_void>
                <can_cancel>0</can_cancel>
                <can_edit>0</can_edit>
                <can_review_payment>0</can_review_payment>
                <can_fetch_transaction_info>0</can_fetch_transaction_info>
                <is_gateway>0</is_gateway>
                <is_offline>0</is_offline>
                <order_status>pending_payment</order_status>
                <!-- Set: the order's email waits for its payment (Quote's SubmitObserver). -->
                <order_place_redirect_url>sattleme/payment/start</order_place_redirect_url>
                <allowspecific>0</allowspecific>
                <sort_order>100</sort_order>
            </sattleme>
        </payment>
    </default>
</config>
