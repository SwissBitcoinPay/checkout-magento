{
    "name": "sattleme/module-payment-dev",
    "description": "The development tools of sattleme/module-payment: Magento's coding standard and PHPStan, pinned. Never shipped.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "bitexpert/phpstan-magento": "0.44.0",
        "magento/magento-coding-standard": "42",
        "phpstan/phpstan": "2.3.7",
        "phpstan/phpstan-strict-rules": "2.1.1"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false
        }
    },
    "scripts": {
        "post-install-cmd": [
            "phpcs --config-set installed_paths ../../magento/magento-coding-standard,../../magento/php-compatibility-fork,../../phpcsstandards/phpcsutils"
        ]
    }
}
